# Template for the Docker-based deployment (Azure VM).
# Copy this file to `.env` on the deployment host and fill in the placeholders.
# Never commit a filled-in copy — `.env` is gitignored and excluded from images.
#
# Generate APP_KEY:
#   docker compose run --rm app php -r "echo 'APP_KEY=base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#
# Generate VAPID keys (web push):
#   docker compose run --rm app php artisan webpush:vapid

APP_NAME="Nusantara Pangkas Rambut"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (consumed by both Laravel and the MySQL container) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nusantara_pangkas
DB_USERNAME=laravel
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- Sessions / cache / queue ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.CHANGE_ME.example.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Mail (replace with real SMTP for production) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@nusantara-pangkas.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Web push (run `php artisan webpush:vapid` once and paste output) ---
VAPID_SUBJECT=mailto:admin@nusantarapangkas.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- TrustHosts (Laravel) ---
# Add the public hostname so reverse-proxied URL generation stays correct.
APP_TRUSTED_HOSTS=CHANGE_ME.example.com
